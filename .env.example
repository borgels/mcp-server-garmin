# Encrypts per-user Garmin tokens at rest (min 16 chars). Never commit.
GARMIN_ENCRYPTION_KEY=
GARMIN_STORE_PATH=/data/store.json
# Public base URL where the browser enrollment form is reachable:
GARMIN_PUBLIC_BASE_URL=https://garmin.me.mcp.borgels.com
# Bind every call to the gateway-verified user (X-MCP-User). Required for the
# hosted, multi-user deployment so each user sees only their own data.
GARMIN_TRUST_FORWARDED_USER=true
GARMIN_ENABLE_WRITES=true
