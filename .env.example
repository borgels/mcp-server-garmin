# Encrypts per-user Garmin tokens at rest (min 16 chars). Never commit.
GARMIN_ENCRYPTION_KEY=
GARMIN_STORE_PATH=/data/store.json
# Public base URL where the browser enrollment form is reachable:
GARMIN_PUBLIC_BASE_URL=https://garmin.me.mcp.example.com
# Bind every call to the gateway-verified user (X-MCP-User). Required for the
# hosted, multi-user deployment so each user sees only their own data.
GARMIN_TRUST_FORWARDED_USER=true
GARMIN_ENABLE_WRITES=true
# Shared bearer the gateway sends on /mcp (Authorization: Bearer <token>). REQUIRED
# when GARMIN_TRUST_FORWARDED_USER=true or on a non-loopback bind (the default
# 0.0.0.0); the server refuses to start without it. At least 32 printable ASCII
# characters, e.g. `openssl rand -hex 32`. Never commit.
MCP_HTTP_TOKEN=

# HTTP transport (defaults shown).
# MCP_HTTP_HOST=0.0.0.0
# PORT=3000
# MCP_AUTH_FAILURE_LIMIT=20
# MCP_AUTH_FAILURE_WINDOW_MS=60000
# Serve /mcp without a token on a non-loopback bind (never with GARMIN_TRUST_FORWARDED_USER):
# MCP_HTTP_ALLOW_UNAUTHENTICATED=false
